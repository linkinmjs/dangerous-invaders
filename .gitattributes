# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Git LFS: binarios (imágenes, audio, 3D, fuentes, archivos comprimidos, PDF, video).
# Instalar con `git lfs install` antes de clonar/pullear.
*.7z filter=lfs diff=lfs merge=lfs -text
